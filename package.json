{
  "name": "barroom-brawl",
  "version": "0.1.0",
  "private": true,
  "description": "Rules and engine experiments for an asymmetric 5x5 chess variant",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "analyze": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "play": "tsx src/play.ts",
    "preview": "vite preview",
    "selfplay": "tsx src/play.ts --side=none --depth=4 --time=100 --max-plies=100",
    "tournament": "tsx src/tournament.ts",
    "test-formations": "tsx src/tournament.ts --formations=all --games-per-formation=10",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.1.5"
  }
}
